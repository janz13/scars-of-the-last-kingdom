{
  "expo": {
    "name": "Scars of the Last Kingdom",
    "slug": "scars-of-the-last-kingdom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sotlk",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#04020a"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scarsofthelastkingdom.app",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },

    "android": {
      "package": "com.scarsofthelastkingdom.app",
      "versionCode": 1,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "backgroundImage": "./assets/icons/adaptive-background.png",
        "backgroundColor": "#04020a"
      },
      "splash": {
        "image": "./assets/images/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#04020a",
        "mdpi":    "./assets/images/icon.png",
        "hdpi":    "./assets/images/icon.png",
        "xhdpi":   "./assets/images/icon.png",
        "xxhdpi":  "./assets/images/icon.png",
        "xxxhdpi": "./assets/images/icon.png"
      },
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS"
      ]
    },

    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "Scars of the Last Kingdom",
      "shortName": "Scars",
      "description": "A dark fantasy survival visual novel RPG. Make choices. Survive the surface. Carry the mark.",
      "themeColor": "#04020a",
      "backgroundColor": "#04020a",
      "lang": "en",
      "scope": "/",
      "display": "standalone",
      "orientation": "portrait",
      "bundler": "metro",
      "output": "static"
    },

    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04020a",
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "buildTarget": "android",
      "gameVersion": "1.0.0",
      "chapters": 14
    }
  }
}
